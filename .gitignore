# --- build output ---------------------------------------------------------
# Everything the Wails CLI produces lands in build/bin: the Linux binary, the
# macOS .app bundle, and the .icns it generates from appicon.png.
/build/bin/

# Bundles and installers, wherever they end up.
*.app/
*.dmg
*.pkg
*.zip
*.tar.gz

# A bare `go build ./...` drops a binary named after the module in the repo
# root. Real builds go to build/bin via the Wails CLI.
/glowpanel

# --- generated source -----------------------------------------------------
# Wails regenerates its JavaScript bindings here on every build (wailsjsdir in
# wails.json). The frontend does not import them — it uses the runtime-injected
# window.go.main.App — so there is nothing worth keeping.
/frontend/wailsjs/

# --- NOT ignored, deliberately --------------------------------------------
# build/appicon.png      source asset: icon theme on Linux, .icns on macOS
# build/darwin/*.plist   Wails bundle *templates* containing {{.Info.*}}
#                        placeholders, plus the CFBundleIdentifier. These are
#                        inputs, not output. Ignoring them makes a fresh clone
#                        build with Wails' stock defaults and silently lose the
#                        com.brennanmke.glowpanel identifier.

# --- secrets --------------------------------------------------------------
# Never commit the MQTT password. The app reads credentials from
# ~/.config/glowkitchen/glow.conf, which lives outside this repo at mode 600 on
# both the Pis and the Mac. This is a guard in case a copy is ever dropped here.
glow.conf
*.local.conf
.env
.env.*

# --- Go -------------------------------------------------------------------
*.exe
*.test
*.out
*.prof
go.work
go.work.sum
/vendor/

# --- runtime --------------------------------------------------------------
*.log

# --- macOS ----------------------------------------------------------------
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# --- editors --------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
