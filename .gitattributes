# Normalise line endings on the way in, check out LF everywhere.
#
# This matters more than usual here: the repo is edited on macOS but the shell
# scripts and .desktop file are consumed by Debian on a Raspberry Pi. A CRLF
# line ending would make bash fail with a confusing "\r: command not found",
# and would silently break the Exec= line in the desktop entry.
* text=auto eol=lf

# Consumed directly by the Pi — must be LF.
*.sh         text eol=lf
*.desktop    text eol=lf
*.conf       text eol=lf

# Source
*.go         text eol=lf
*.js         text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
go.mod       text eol=lf
go.sum       text eol=lf

# Binary assets — never touch these.
*.png        binary
*.jpg        binary
*.ico        binary
*.icns       binary

# Keep dependency churn out of diffs and reviews. Still tracked, still needed
# for reproducible builds; just not worth reading.
go.sum       linguist-generated=true -diff

# GitHub reports this as a Go project. Without the hint the hand-written CSS
# and JS in frontend/dist can outweigh the Go by line count.
frontend/dist/*.css  linguist-vendored=false
frontend/dist/*.js   linguist-vendored=false
*.go                 linguist-detectable=true
